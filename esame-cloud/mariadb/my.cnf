[mysqld]
# no DNS lookups for client hosts, no file access from SQL
skip-name-resolve
local-infile = 0
secure-file-priv = /var/lib/mysql-files

character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# sized for a single WordPress site (buffer pool is set per site in the compose file)
max_connections = 50
max_allowed_packet = 64M
performance_schema = OFF

[client]
default-character-set = utf8mb4
