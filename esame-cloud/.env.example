# --- Site ------------------------------------------------------------------
SITE_NAME=esempio
SITE_DOMAIN=esempio.it
# published HTTPS port (one per instance on the same host)
HTTPS_PORT=443
# public URL of the site; empty = https://SITE_DOMAIN (set it when HTTPS_PORT is not 443)
SITE_URL=
# cloudflare: Origin CA + Authenticated Origin Pulls + Cloudflare IPs only
# test: self-signed certificate, no Cloudflare checks (local VM)
ORIGIN_MODE=cloudflare

# --- Base images (pin by digest: name:tag@sha256:...) ----------------------
WORDPRESS_IMAGE=wordpress:php8.5-fpm-alpine
NGINX_IMAGE=nginx:stable-alpine3.24-slim
MARIADB_IMAGE=mariadb:lts-ubi10
REDIS_IMAGE=redis:8.8-alpine

# --- Build: tools added to the WordPress image -----------------------------
WP_CLI_VERSION=2.12.0
WP_CLI_SHA512=be928f6b8ca1e8dfb9d2f4b75a13aa4aee0896f8a9a0a1c45cd5d2c98605e6172e6d014dda2e27f88c98befc16c040cbb2bd1bfa121510ea5cdf5f6a30fe8832
REDIS_CACHE_VERSION=3.0.0

# --- Database --------------------------------------------------------------
DB_NAME=wordpress
DB_USER=wordpress
# must match the table prefix of an imported dump
DB_TABLE_PREFIX=wp_
DB_BUFFER_POOL=128M

# --- New site (ignored when a site is imported from ./import) --------------
WP_TITLE=WordPress
WP_ADMIN_USER=
WP_ADMIN_EMAIL=

# --- Updater ---------------------------------------------------------------
# daily run, HH:MM in UTC
UPDATE_TIME=03:00
WP_BACKUP_KEEP=7

# --- nginx: cache and rate limits ------------------------------------------
NGINX_CACHE_MAX_SIZE=512m
NGINX_CACHE_PAGE_TTL=10m
NGINX_CACHE_STATIC_TTL=7d
NGINX_RATE_PAGES=10r/s
NGINX_RATE_API=5r/s
NGINX_RATE_LOGIN=5r/m
NGINX_CONN_PER_IP=20

# --- Resources per service -------------------------------------------------
NGINX_CPUS=0.50
NGINX_MEMORY=128M
WORDPRESS_CPUS=1.00
WORDPRESS_MEMORY=256M
PHP_FPM_MAX_CHILDREN=5
DB_CPUS=0.50
DB_MEMORY=384M
REDIS_CPUS=0.25
REDIS_MEMORY=48M
REDIS_MAXMEMORY=32mb
UPDATER_CPUS=1.00
UPDATER_MEMORY=768M

# --- Secrets: files in secrets/ (directory 0700, files 0644) ---------------
# The containers run as their own users (mysql, redis, nginx, www-data), so the
# files must be readable by them; the 0700 directory keeps other host users out.
#   secrets/db_password          MariaDB password of DB_USER
#   secrets/db_root_password     MariaDB root password
#   secrets/redis_password       Redis password
#   secrets/wp_admin_password    admin password of a new site
#   secrets/wordfence_api_key    Wordfence Intelligence API key
#   secrets/update_webhook_url   webhook for update reports (may be empty)
#   secrets/origin_cert.pem      Cloudflare Origin CA certificate
#   secrets/origin_key.pem       its private key
#   secrets/origin_pull_ca.pem   Cloudflare Authenticated Origin Pulls CA
