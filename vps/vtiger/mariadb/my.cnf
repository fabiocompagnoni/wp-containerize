[mysqld]
# no DNS lookups for client hosts, no file access from SQL
skip-name-resolve
local-infile = 0
secure-file-priv = /var/lib/mysql-files

# vtiger is not compatible with the strict modes of MariaDB (empty values in numeric
# and date columns, GROUP BY on non-aggregated columns): permissive mode as it requires
sql_mode = NO_ENGINE_SUBSTITUTION
innodb_strict_mode = OFF

# sized for a single CRM (buffer pool is set per site in the compose file)
max_connections = 30
max_allowed_packet = 64M
performance_schema = OFF
thread_cache_size = 8
table_open_cache = 1000
table_definition_cache = 1000
tmp_table_size = 32M
max_heap_table_size = 32M
key_buffer_size = 8M
innodb_log_buffer_size = 8M

[client]
default-character-set = utf8mb4
