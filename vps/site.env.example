# --- Site ------------------------------------------------------------------
SITE_NAME=esempio
SITE_DOMAIN=esempio.it
# wordpress (compose.yaml) or vtiger (vtiger/compose.yaml); set by new-site.sh --type
SITE_TYPE=wordpress
# canonical URL; empty = https://SITE_DOMAIN. Both SITE_DOMAIN and www.SITE_DOMAIN are served.
# migrate-site.sh keeps the www form when the old site used it.
SITE_URL=
# cloudflare: Origin CA + Authenticated Origin Pulls + Cloudflare IPs only
# test: self-signed certificate, no Cloudflare checks (local VM)
ORIGIN_MODE=cloudflare

# --- Networks ----------------------------------------------------------------
# The site uses NET_PREFIX.SITE_NET.0/24, split into four /26 networks:
#   .0 edge (edge <-> nginx), .64 web (nginx <-> php), .128 data (php <-> db, redis),
#   .192 egress (php -> Internet). new-site.sh picks the first free SITE_NET (1-254).
# Change NET_PREFIX only if 10.200.0.0/16 is already used on the host or its LAN.
NET_PREFIX=10.200
SITE_NET=
# DNS for the containers that reach the Internet (wordpress, updater)
CONTAINER_DNS_1=1.1.1.1
CONTAINER_DNS_2=9.9.9.9

# --- Database --------------------------------------------------------------
DB_NAME=wordpress
DB_USER=wordpress
# must match the table prefix of an imported dump
DB_TABLE_PREFIX=wp_
DB_BUFFER_POOL=64M

# --- Email (wp_mail through msmtp) -----------------------------------------
# Authenticated SMTP of a mailbox of the site; the password goes in secrets/smtp_password.
# Port 587 (STARTTLS): Hetzner blocks 25 and 465 outbound. Empty SMTP_HOST = no email.
# Aruba mailboxes (MX mail.<domain> or in.arubabusiness.it): mail.postassl.it, the name in
# the TLS certificate of that service (smtp.arubabusiness.it presents *.postassl.it, and
# smtps.aruba.it refuses these mailboxes with 535).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# sender of every message; empty = SMTP_USER
SMTP_FROM=

# --- New site (ignored when a site is imported from ./import) --------------
WP_TITLE=WordPress
WP_ADMIN_USER=
WP_ADMIN_EMAIL=

# --- Updater (run daily by the wp-update timer, see jobs.sh) -----------------
WP_BACKUP_KEEP=7

# --- nginx: cache and rate limits ------------------------------------------
NGINX_CACHE_MAX_SIZE=512m
NGINX_CACHE_PAGE_TTL=10m
NGINX_CACHE_STATIC_TTL=7d
NGINX_RATE_PAGES=10r/s
NGINX_RATE_API=5r/s
NGINX_RATE_LOGIN=5r/m
NGINX_CONN_PER_IP=20

# --- Resources per service (the edge proxy has its own, in edge/compose.yaml) -------------------------------------------------
NGINX_CPUS=0.50
NGINX_MEMORY=128M
WORDPRESS_CPUS=1.00
WORDPRESS_MEMORY=256M
# PHP workers are started on demand and stop after 10 s without requests:
# max ~ WORDPRESS_MEMORY / 60-120M (heavy themes like Divi need more per worker)
PHP_FPM_MAX_CHILDREN=4
DB_CPUS=0.50
DB_MEMORY=256M
REDIS_CPUS=0.25
REDIS_MEMORY=48M
REDIS_MAXMEMORY=32mb
UPDATER_CPUS=1.00
UPDATER_MEMORY=768M

# --- Secrets: files in secrets/ (directory 0700, files 0644) ---------------
# The containers run as their own users (mysql, redis, nginx, www-data), so the
# files must be readable by them; the 0700 directory keeps other host users out.
#   secrets/db_password          MariaDB password of DB_USER
#   secrets/db_root_password     MariaDB root password
#   secrets/redis_password       Redis password
#   secrets/wp_admin_password    admin password of a new site
#   secrets/wordfence_api_key    Wordfence Intelligence API key
#   secrets/update_webhook_url   webhook for update reports (may be empty)
#   secrets/smtp_password        password of the SMTP mailbox (may be empty)
#   secrets/origin_cert.pem      Cloudflare Origin CA certificate (mounted in the edge)
#   secrets/origin_key.pem       its private key
