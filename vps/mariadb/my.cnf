[mysqld]
# no DNS lookups for client hosts, no file access from SQL
skip-name-resolve
local-infile = 0
secure-file-priv = /var/lib/mysql-files

character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# sized for a single WordPress site (buffer pool is set per site in the compose file):
# PHP workers + updater + backup need few connections, keep every buffer small
max_connections = 20
max_allowed_packet = 64M
performance_schema = OFF
thread_cache_size = 8
table_open_cache = 400
table_definition_cache = 400
tmp_table_size = 16M
max_heap_table_size = 16M
key_buffer_size = 8M
innodb_log_buffer_size = 8M

[client]
default-character-set = utf8mb4
