# Build settings, used only by build.sh on the build machine.

# Registry for the three images (private GHCR: docker login ghcr.io).
# Set the real one in build.local.env, which is not versioned.
REGISTRY=ghcr.io/OWNER

# --- Base images (pin by digest: name:tag@sha256:...) ----------------------
WORDPRESS_IMAGE=wordpress:php8.5-fpm-alpine
NGINX_IMAGE=nginx:stable-alpine3.24-slim

# --- Used as they are on the VPS, copied into images.env -------------------
MARIADB_IMAGE=mariadb:lts-ubi10
REDIS_IMAGE=redis:8.8-alpine
# FTP/SFTP download of the sites to migrate (lftp installed at run time)
MIRROR_IMAGE=alpine:3.24
# backups to the Hetzner Storage Box (backup.sh)
RESTIC_IMAGE=restic/restic:0.19.1

# --- Tools added to the WordPress image -------------------------------------
WP_CLI_VERSION=2.12.0
WP_CLI_SHA512=be928f6b8ca1e8dfb9d2f4b75a13aa4aee0896f8a9a0a1c45cd5d2c98605e6172e6d014dda2e27f88c98befc16c040cbb2bd1bfa121510ea5cdf5f6a30fe8832
REDIS_CACHE_VERSION=3.0.0
