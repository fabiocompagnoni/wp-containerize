# Copy to backup.env (not versioned). Used by backup.sh.

# restic repository: SFTP on a Hetzner Storage Box (SSH on port 23).
# The path after ":" is relative to the home of the Storage Box user.
# A local absolute path (e.g. an attached volume) also works.
RESTIC_REPOSITORY=sftp:u123456@u123456.your-storagebox.de:wp-backups
SSH_PORT=23

# retention, per site
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6

# optional: POST with a JSON report when a backup fails
BACKUP_WEBHOOK_URL=
