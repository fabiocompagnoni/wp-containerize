[mysqld]
# no DNS lookups for client hosts, no file access from SQL
skip-name-resolve
local-infile = 0
secure-file-priv = /var/lib/mysql-files

# applications coming from shared hostings (PrestaShop, hand-written PHP) often rely on the
# permissive mode: inserts without NOT NULL columns, empty values in numeric/date columns
sql_mode = NO_ENGINE_SUBSTITUTION
innodb_strict_mode = OFF

character-set-server = utf8mb4

# sized for a single site (buffer pool is set per site in the compose file)
max_connections = 40
max_allowed_packet = 64M
performance_schema = OFF
thread_cache_size = 8
table_open_cache = 2000
table_definition_cache = 2000
tmp_table_size = 32M
max_heap_table_size = 32M
key_buffer_size = 8M
innodb_log_buffer_size = 16M

[client]
default-character-set = utf8mb4
